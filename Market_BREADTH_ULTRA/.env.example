# ── IBOV Market Breadth — Environment Variables ───────────────────
# Copie este arquivo para .env e ajuste os valores

# Banco de dados
DATABASE_PATH=database/ibov_breadth.db

# Logs
LOG_LEVEL=INFO
LOG_PATH=logs/

# Download
DOWNLOAD_START_DATE=2020-01-01
DOWNLOAD_MAX_WORKERS=5

# Dashboard
DASHBOARD_OUTPUT=dashboard/index.html

# Relatórios
REPORTS_OUTPUT=reports/

# Scheduler (horário de atualização automática, formato HH:MM)
SCHEDULER_TIME=18:30
