//@version=5
indicator("Fluxo Acumulado - Investidor Estrangeiro IBOV", shorttitle="FluxoExt", overlay=false, scale=scale.right, max_bars_back=500)

// =====================================================================
// INPUTS
// =====================================================================
GRP_DADOS = "Fonte de Dados"
GRP_VIS   = "Visual"
GRP_MEDIA = "Media Movel"
GRP_TBL   = "Tabela"
GRP_ALERT = "Alertas"

i_simbolo    = input.symbol(defval="SPREADSHEET:FLUXO_EST_IBOV",   title="Simbolo do CSV Importado",  group=GRP_DADOS, tooltip="Importar fluxo_estrangeiro.csv no TradingView e nomear como FLUXO_EST_IBOV")
i_periodo    = input.string(defval="Acumulado Total", title="Periodo", options=["Acumulado Total","No Ano (YTD)","No Mes"], group=GRP_DADOS)

i_cor_pos    = input.color(#26a69a,      title="Cor Positivo",          group=GRP_VIS)
i_cor_neg    = input.color(#ef5350,      title="Cor Negativo",          group=GRP_VIS)
i_cor_linha  = input.color(color.white,  title="Cor Linha Acumulado",   group=GRP_VIS)
i_linha_w    = input.int(2,              title="Espessura Linha",  minval=1, maxval=5, group=GRP_VIS)
i_hist       = input.bool(true,          title="Mostrar Histograma",    group=GRP_VIS)
i_bg         = input.bool(true,          title="Background por Zona",   group=GRP_VIS)

i_media      = input.bool(true,   title="Ativar",             group=GRP_MEDIA)
i_media_tipo = input.string("EMA", title="Tipo", options=["EMA","SMA","WMA"], group=GRP_MEDIA)
i_media_per  = input.int(21,       title="Periodo", minval=2, maxval=200,     group=GRP_MEDIA)

i_tabela     = input.bool(true,                     title="Mostrar Tabela",   group=GRP_TBL)
i_pos_tbl    = input.string("Canto Superior Direito", title="Posicao",
    options=["Canto Superior Direito","Canto Superior Esquerdo","Canto Inferior Direito","Canto Inferior Esquerdo"],
    group=GRP_TBL)

i_alert_zero  = input.bool(true, title="Alerta cruzamento zero",  group=GRP_ALERT)
i_alert_media = input.bool(true, title="Alerta cruzamento media", group=GRP_ALERT)

// =====================================================================
// DADOS EXTERNOS  (obrigatorio no escopo global)
// =====================================================================
// CSV gerado por gerar_csv.py:
//   close  = saldo_acumulado
//   open   = saldo_acumulado do dia anterior  (close - open = saldo_dia)
//   volume = abs(saldo_dia)

[f_close, f_open, f_vol] = request.security(i_simbolo, "D", [close, open, volume], gaps=barmerge.gaps_on)

f_dia       = f_close - f_open
f_acumulado = f_close

// =====================================================================
// DETECTAR AUSENCIA DE DADOS
// =====================================================================
sem_dados = na(f_close)

// =====================================================================
// CALCULOS (so executados quando ha dados)
// =====================================================================
var float acum_ytd = 0.0
var float acum_mes = 0.0

eh_novo_ano = not na(time[1]) and year(time)  != year(time[1])
eh_novo_mes = not na(time[1]) and month(time) != month(time[1])

if not na(f_dia)
    if eh_novo_ano
        acum_ytd := 0.0
    if eh_novo_mes
        acum_mes := 0.0
    acum_ytd += nz(f_dia, 0.0)
    acum_mes += nz(f_dia, 0.0)

serie_acum = switch i_periodo
    "No Ano (YTD)" => acum_ytd
    "No Mes"       => acum_mes
    =>               f_acumulado

media_acum = switch i_media_tipo
    "SMA" => ta.sma(serie_acum, i_media_per)
    "WMA" => ta.wma(serie_acum, i_media_per)
    =>       ta.ema(serie_acum, i_media_per)

cor_dia   = nz(f_dia,      0.0) >= 0 ? i_cor_pos : i_cor_neg
cor_acum  = nz(serie_acum, 0.0) >= 0 ? i_cor_pos : i_cor_neg
cor_media = nz(media_acum, 0.0) >= 0 ? color.new(i_cor_pos, 40) : color.new(i_cor_neg, 40)

// =====================================================================
// PLOTS
// =====================================================================
plot(i_hist and not sem_dados ? f_dia : na,     title="Fluxo Diario",    style=plot.style_histogram, color=color.new(cor_dia, 25), linewidth=4)
p_acum  = plot(not sem_dados ? serie_acum : na, title="Saldo Acumulado", color=i_cor_linha,  linewidth=i_linha_w)
p_media = plot(i_media and not sem_dados ? media_acum : na, title="Media",  color=cor_media, linewidth=1)

fill(p_acum, p_media, color=serie_acum >= media_acum ? color.new(i_cor_pos, 88) : color.new(i_cor_neg, 88), title="Zona vs Media")
hline(0, "Zero", color=color.new(color.gray, 35), linestyle=hline.style_dashed, linewidth=1)
bgcolor(i_bg and nz(serie_acum) > 0 ? color.new(i_cor_pos, 94) : i_bg and nz(serie_acum) < 0 ? color.new(i_cor_neg, 94) : na, title="Background")

// =====================================================================
// TABELA
// =====================================================================
pos_tbl = switch i_pos_tbl
    "Canto Superior Esquerdo" => position.top_left
    "Canto Inferior Direito"  => position.bottom_right
    "Canto Inferior Esquerdo" => position.bottom_left
    =>                           position.top_right

var table tbl = table.new(pos_tbl, 2, 8,
    bgcolor      = color.new(color.black, 58),
    border_color = color.new(color.gray, 55),
    border_width = 1,
    frame_color  = color.new(color.gray, 25),
    frame_width  = 1)

f_fmt(v) =>
    abs_v = math.abs(nz(v, 0.0))
    sinal = nz(v, 0.0) >= 0 ? "(+) " : "(-) "
    abs_v >= 1000.0
        ? sinal + str.tostring(abs_v / 1000.0, "0.00") + " bi"
        : sinal + str.tostring(abs_v, "#,##0") + " mi"

lbl_periodo = i_periodo == "No Ano (YTD)" ? "No Ano" : i_periodo == "No Mes" ? "No Mes" : "Acumulado"

if barstate.islast and i_tabela

    // -- CABECALHO --------------------------------------------------
    table.cell(tbl, 0, 0, "FLUXO ESTRANGEIRO | IBOV",
        text_color=color.white, text_size=size.small,
        bgcolor=color.new(color.navy, 25), text_halign=text.align_center)
    table.merge_cells(tbl, 0, 0, 1, 0)

    if sem_dados
        // -- ESTADO DE ERRO: dados nao importados --------------------
        table.cell(tbl, 0, 1, "DADOS NAO ENCONTRADOS",
            text_color=color.new(#ef5350, 0), text_size=size.small,
            bgcolor=color.new(color.black, 50), text_halign=text.align_center)
        table.merge_cells(tbl, 0, 1, 1, 1)

        table.cell(tbl, 0, 2, "Passo 1:",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 62))
        table.cell(tbl, 1, 2, "Execute gerar_csv.py",
            text_color=color.new(#26a69a, 0), text_size=size.tiny,
            bgcolor=color.new(color.black, 62), text_halign=text.align_right)

        table.cell(tbl, 0, 3, "Passo 2:",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 68))
        table.cell(tbl, 1, 3, "Importe o CSV no TradingView",
            text_color=color.new(#26a69a, 0), text_size=size.tiny,
            bgcolor=color.new(color.black, 68), text_halign=text.align_right)

        table.cell(tbl, 0, 4, "Passo 3:",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 62))
        table.cell(tbl, 1, 4, "Nome: FLUXO_EST_IBOV",
            text_color=color.new(#26a69a, 0), text_size=size.tiny,
            bgcolor=color.new(color.black, 62), text_halign=text.align_right)

        table.cell(tbl, 0, 5, "Passo 4:",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 68))
        table.cell(tbl, 1, 5, "Recarregue o indicador",
            text_color=color.new(#26a69a, 0), text_size=size.tiny,
            bgcolor=color.new(color.black, 68), text_halign=text.align_right)

        table.cell(tbl, 0, 6, "Ver: Instalacao_TradingView.md",
            text_color=color.new(color.gray, 40), text_size=size.tiny,
            bgcolor=color.new(color.black, 80), text_halign=text.align_center)
        table.merge_cells(tbl, 0, 6, 1, 6)

        // Linha vazia final
        table.cell(tbl, 0, 7, "", bgcolor=color.new(color.black, 80))
        table.merge_cells(tbl, 0, 7, 1, 7)

    else
        // -- ESTADO NORMAL: exibir dados ----------------------------
        table.cell(tbl, 0, 1, "Hoje",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 68))
        table.cell(tbl, 1, 1, not na(f_dia) ? f_fmt(f_dia) : "---",
            text_color=cor_dia, text_size=size.small,
            text_halign=text.align_right, bgcolor=color.new(color.black, 68))

        table.cell(tbl, 0, 2, lbl_periodo,
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 62))
        table.cell(tbl, 1, 2, not na(serie_acum) ? f_fmt(serie_acum) : "---",
            text_color=cor_acum, text_size=size.small,
            text_halign=text.align_right, bgcolor=color.new(color.black, 62))

        table.cell(tbl, 0, 3, i_media_tipo + " " + str.tostring(i_media_per) + "d",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 68))
        table.cell(tbl, 1, 3, i_media and not na(media_acum) ? f_fmt(media_acum) : "---",
            text_color=cor_media, text_size=size.small,
            text_halign=text.align_right, bgcolor=color.new(color.black, 68))

        acum_vs_med   = not na(serie_acum) and not na(media_acum) and i_media ? serie_acum - media_acum : na
        lbl_rel       = not na(acum_vs_med) ? (acum_vs_med >= 0 ? "Acima da media" : "Abaixo da media") : "---"
        cor_rel       = not na(acum_vs_med) ? (acum_vs_med >= 0 ? i_cor_pos : i_cor_neg) : color.gray

        table.cell(tbl, 0, 4, "Posicao",
            text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.black, 62))
        table.cell(tbl, 1, 4, lbl_rel,
            text_color=cor_rel, text_size=size.tiny,
            text_halign=text.align_right, bgcolor=color.new(color.black, 62))

        table.cell(tbl, 0, 5, "Ultima data",
            text_color=color.new(color.gray, 20), text_size=size.tiny, bgcolor=color.new(color.black, 72))
        table.cell(tbl, 1, 5, not na(time) ? str.format_time(time, "dd/MM/yyyy") : "---",
            text_color=color.new(color.gray, 10), text_size=size.tiny,
            text_halign=text.align_right, bgcolor=color.new(color.black, 72))

        table.cell(tbl, 0, 6, "B3 via dadosdemercado.com.br",
            text_color=color.new(color.gray, 45), text_size=size.tiny,
            bgcolor=color.new(color.black, 80), text_halign=text.align_center)
        table.merge_cells(tbl, 0, 6, 1, 6)

        // Linha vazia final
        table.cell(tbl, 0, 7, "", bgcolor=color.new(color.black, 80))
        table.merge_cells(tbl, 0, 7, 1, 7)

// =====================================================================
// ALERTAS
// =====================================================================
alertcondition(i_alert_zero  and ta.crossover(serie_acum, 0),            title="FluxoExt: Acumulado Positivo",       message="Fluxo Estrangeiro IBOV: acumulado POSITIVO em {{time}} | {{ticker}}")
alertcondition(i_alert_zero  and ta.crossunder(serie_acum, 0),           title="FluxoExt: Acumulado Negativo",       message="Fluxo Estrangeiro IBOV: acumulado NEGATIVO em {{time}} | {{ticker}}")
alertcondition(i_alert_media and i_media and ta.crossover(serie_acum, media_acum),  title="FluxoExt: Cruzou ACIMA da media",  message="Fluxo Estrangeiro IBOV: acumulado cruzou ACIMA da media em {{time}}")
alertcondition(i_alert_media and i_media and ta.crossunder(serie_acum, media_acum), title="FluxoExt: Cruzou ABAIXO da media", message="Fluxo Estrangeiro IBOV: acumulado cruzou ABAIXO da media em {{time}}")
