# Ambientes virtuais
.venv/
venv/
env/

# Cache Python
__pycache__/
*.pyc
*.pyo

# Logs e saídas de servidor
server_out.txt
server_err.txt
*.log

# Banco de dados local
*.db
*.sqlite

# Cache de preço ao vivo (yfinance) — regenerado a cada fetch, diferente por ambiente
MacroDashboard/data/price_cache.json

# Cache de reserva do arquivo de OI da B3 (GammaScreener) — regenerado a
# cada fetch bem-sucedido, ~10MB, diferente por ambiente
GammaScreener/b3_oi_cache.json

# Cache do screener em disco (GammaScreener) — sobrevive a restart do
# processo, regenerado a cada calculo bem-sucedido, diferente por ambiente
GammaScreener/screener_cache.json

# Dados da Biblioteca (posts reais do usuário, mídias e chave de API) — nunca no git
biblioteca/data/

# Dados do Portfolio (carteiras reais de clientes + secret_key da sessão) — nunca no git,
# igual Biblioteca acima. Provisionamento roda direto em cada ambiente (local/VPS).
Portfolio/data/

# Segredo de sessão do login do Hub (gerado por ambiente, nunca compartilhado)
auth/.session_secret

# Segredo do push do calendário econômico (PC local -> VPS), nunca compartilhado
.calendar_push_secret

# Arquivos de configuração local do Claude
.claude/

# Credenciais da API OpLab (GammaScreener) — nunca no git, provisionar por ambiente
GammaScreener/.env
.env

# Imagens e binários pesados desnecessários
docs/Tradingview_Fundos_Exemplo.bmp
